<%- include('partials/header', { title: 'Login' }) %>

<main class="auth-main">
  <div class="auth-card">
    <div class="auth-logo">Snap<span>Link</span></div>
    <h2>Welcome back</h2>
    <p class="auth-sub">Login to manage your links</p>

    <form action="/auth/login" method="POST" class="auth-form">
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="omsingh5157@gmail.com" required/>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Your password" required/>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Login</button>
    </form>

    <p class="auth-switch">Don't have an account? <a href="/auth/register">Sign up free</a></p>
  </div>
</main>

<%- include('partials/footer') %>
