<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= typeof title !== 'undefined' ? title : 'SnapLink' %> — URL Shortener</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<nav class="navbar">
  <a class="nav-brand" href="/">Snap<span>Link</span></a>
  <div class="nav-links">
    <% if (user) { %>
      <span class="nav-user">👋 <%= user.name.split(' ')[0] %></span>
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/auth/logout" class="btn btn-outline btn-sm">Logout</a>
    <% } else { %>
      <a href="/auth/login"    class="nav-link">Login</a>
      <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up Free</a>
    <% } %>
  </div>
</nav>

<div class="flash-wrap">
  <% if (success_msg && success_msg.length > 0) { %>
    <div class="flash flash-success">✅ <%= success_msg %></div>
  <% } %>
  <% if (error_msg && error_msg.length > 0) { %>
    <div class="flash flash-error">❌ <%= error_msg %></div>
  <% } %>
</div>
