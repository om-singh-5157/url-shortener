<%- include('partials/header', { title: 'Analytics' }) %>

<main class="analytics-main">
  <div class="analytics-header">
    <a href="/dashboard" class="back-btn">← Back to Dashboard</a>
    <div>
      <h1>📊 Link Analytics</h1>
      <p class="url-display">
        <a href="<%= baseUrl %>/<%= url.customAlias || url.shortCode %>" target="_blank">
          <%= baseUrl.replace(/https?:\/\//,'') %>/<%= url.customAlias || url.shortCode %>
        </a>
        → <span class="orig"><%= url.originalUrl.substring(0, 60) %><%= url.originalUrl.length > 60 ? '...' : '' %></span>
      </p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="analytics-summary">
    <div class="sum-card highlight">
      <div class="sum-num"><%= url.clicks.length %></div>
      <div class="sum-label">Total Clicks</div>
    </div>
    <div class="sum-card">
      <div class="sum-num"><%= new Date(url.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'2-digit'}) %></div>
      <div class="sum-label">Created On</div>
    </div>
    <div class="sum-card">
      <div class="sum-num"><%= url.expiresAt ? new Date(url.expiresAt).toLocaleDateString('en-IN') : 'Never' %></div>
      <div class="sum-label">Expires</div>
    </div>
    <div class="sum-card">
      <div class="sum-num" style="color:<%= url.isActive ? '#2ECC71' : '#E74C3C' %>">
        <%= url.isActive ? 'Active' : 'Inactive' %>
      </div>
      <div class="sum-label">Status</div>
    </div>
  </div>

  <!-- Charts -->
  <div class="charts-grid">
    <div class="chart-card wide">
      <h3>Clicks Over Time (Last 14 Days)</h3>
      <canvas id="clicksChart"></canvas>
    </div>
    <div class="chart-card">
      <h3>By Browser</h3>
      <canvas id="browserChart"></canvas>
    </div>
    <div class="chart-card">
      <h3>By Operating System</h3>
      <canvas id="osChart"></canvas>
    </div>
    <div class="chart-card">
      <h3>By Device Type</h3>
      <canvas id="deviceChart"></canvas>
    </div>
  </div>

  <!-- Recent Clicks Table -->
  <% if (url.clicks.length > 0) { %>
  <div class="recent-clicks">
    <h3>Recent Clicks</h3>
    <table class="url-table">
      <thead><tr><th>#</th><th>Time</th><th>Browser</th><th>OS</th><th>Device</th><th>Referrer</th></tr></thead>
      <tbody>
        <% url.clicks.slice().reverse().slice(0,20).forEach((c, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= new Date(c.timestamp).toLocaleString('en-IN') %></td>
            <td><%= c.browser %></td>
            <td><%= c.os %></td>
            <td><%= c.device %></td>
            <td><%= c.referrer %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
    <div class="empty-state" style="margin-top:2rem;">
      <div class="empty-icon">📭</div>
      <h3>No clicks yet</h3>
      <p>Share your short link to start tracking!</p>
    </div>
  <% } %>
</main>

<script>
const CHART_COLORS = ['#5B8DEF','#2ECC71','#F5A623','#E74C3C','#9B59B6','#1ABC9C','#E67E22','#3498DB'];
const opts = { responsive: true, plugins: { legend: { labels: { color: '#E8EAF0' } } }, scales: { x: { ticks: { color:'#8B90A8' }, grid: { color:'#2E3250' } }, y: { ticks: { color:'#8B90A8' }, grid: { color:'#2E3250' } } } };
const donutOpts = { responsive: true, plugins: { legend: { position:'bottom', labels:{ color:'#E8EAF0', padding:12 } } } };

// Clicks over time
const cd = <%- clicksByDay %>;
new Chart(document.getElementById('clicksChart'), {
  type: 'line',
  data: { labels: cd.labels, datasets: [{ label:'Clicks', data: cd.data, borderColor:'#5B8DEF', backgroundColor:'rgba(91,141,239,0.15)', tension:0.4, fill:true, pointBackgroundColor:'#5B8DEF' }] },
  options: opts
});

// Browser chart
const bd = <%- clicksByBrowser %>;
new Chart(document.getElementById('browserChart'), {
  type: 'doughnut',
  data: { labels: bd.labels, datasets: [{ data: bd.data, backgroundColor: CHART_COLORS }] },
  options: donutOpts
});

// OS chart
const od = <%- clicksByOS %>;
new Chart(document.getElementById('osChart'), {
  type: 'doughnut',
  data: { labels: od.labels, datasets: [{ data: od.data, backgroundColor: CHART_COLORS }] },
  options: donutOpts
});

// Device chart
const dd = <%- clicksByDevice %>;
new Chart(document.getElementById('deviceChart'), {
  type: 'bar',
  data: { labels: dd.labels, datasets: [{ label:'Clicks', data: dd.data, backgroundColor: CHART_COLORS }] },
  options: { ...opts, plugins: { legend: { display:false } } }
});
</script>

<%- include('partials/footer') %>
